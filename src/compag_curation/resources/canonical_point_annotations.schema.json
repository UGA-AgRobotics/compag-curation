{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:compag-curation:schema:canonical-point-annotations:v1",
  "title": "COMPAG canonical point annotations v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "source_filename", "source_sha256", "rows"],
  "properties": {
    "schema": {"const": "compag-curation-canonical-point-annotations/v1"},
    "status": {"const": "PASS"},
    "source_filename": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image", "label", "x", "y", "width", "height"],
        "properties": {
          "image": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$"},
          "label": {"const": "cj"},
          "x": {"type": "number", "minimum": 0},
          "y": {"type": "number", "minimum": 0},
          "width": {"type": "integer", "minimum": 1, "maximum": 16384},
          "height": {"type": "integer", "minimum": 1, "maximum": 16384}
        }
      }
    }
  }
}
